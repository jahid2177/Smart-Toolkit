<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     app:strokeColor="#00BFA5"
     android:layout_margin="16dp"
     app:strokeWidth="1dp"
     app:cardBackgroundColor="#1A1A1A"
     app:cardCornerRadius="20dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_horizontal"
         android:padding="24dp"
         android:orientation="vertical">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="22sp"
             android:textColor="@color/white"
             android:text="Smart PDF Toolkit"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="#888888"
             android:layout_marginTop="4dp"
             android:text="Version 1.0 (AI Edition)" />

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:layout_marginBottom="16dp"
             android:background="#333333"
             android:layout_marginTop="16dp" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center"
             android:textSize="14sp"
             android:textColor="#00BFA5"
             android:text="This app is completely Ad-Free and not for sale. Built to help the community."
             android:textStyle="italic" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center"
             android:textSize="16sp"
             android:textColor="@color/white"
             android:layout_marginTop="20dp"
             android:text="Developer: Md. Jahidul Islam"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center"
             android:textSize="12sp"
             android:textColor="#BBBBBB"
             android:layout_marginTop="4dp"
             android:text="If you have any query, feel free to contact me." />

        <Button
             android:layout_height="60dp"
             android:layout_width="match_parent"
             app:cornerRadius="12dp"
             android:backgroundTint="#25D366"
             android:textColor="@color/white"
             android:layout_marginTop="24dp"
             android:id="@+id/btnWhatsApp"
             android:text="Contact on WhatsApp"
             android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>