<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#1B1514">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="16dp"
         android:orientation="vertical"
         android:id="@+id/headerLayout">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal">

            <ImageView
                 android:layout_height="24dp"
                 android:layout_width="24dp"
                 android:src="@android:drawable/ic_menu_revert"
                 app:tint="@color/white"
                 android:id="@+id/btnBack" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:textColor="@color/white"
                 android:layout_marginStart="16dp"
                 android:text="Settings"
                 android:textStyle="bold" />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="24sp"
             android:textColor="@color/white"
             android:layout_marginTop="20dp"
             android:text="Rotate PDF"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:visibility="gone"
             android:textSize="14sp"
             android:textColor="#D1C4E9"
             android:layout_marginTop="4dp"
             android:id="@+id/tvSubtitle"
             android:text="⚠ Tap rotate icon on each page to rotate" />

    </LinearLayout>

    <Button
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_centerInParent="true"
         android:backgroundTint="#F2A999"
         android:textColor="#000000"
         android:id="@+id/btnSelectPdf"
         android:text="Select PDF File" />

    <androidx.recyclerview.widget.RecyclerView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:layout_below="@id/headerLayout"
         android:layout_above="@+id/bottomOptions"
         android:padding="8dp"
         android:clipToPadding="false"
         android:id="@+id/rvPages" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="#1B1514"
         android:padding="16dp"
         android:orientation="vertical"
         android:visibility="gone"
         android:layout_alignParentBottom="true"
         android:id="@+id/bottomOptions">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:weightSum="3"
             android:orientation="horizontal">

            <Button
                 android:layout_height="48dp"
                 android:layout_width="0dp"
                 android:layout_marginEnd="4dp"
                 android:backgroundTint="#3D302E"
                 android:textColor="#F2A999"
                 android:layout_weight="1"
                 android:id="@+id/btnRotateLeft"
                 android:text="-90° L" />

            <Button
                 android:layout_height="48dp"
                 android:layout_width="0dp"
                 android:backgroundTint="#3D302E"
                 android:textColor="#F2A999"
                 android:layout_marginHorizontal="4dp"
                 android:layout_weight="1"
                 android:id="@+id/btnRotateRight"
                 android:text="+90° R" />

            <Button
                 android:layout_height="48dp"
                 android:layout_width="0dp"
                 android:layout_marginStart="4dp"
                 android:backgroundTint="#3D302E"
                 android:textColor="#F2A999"
                 android:layout_weight="1"
                 android:id="@+id/btnFlip"
                 android:text="180°" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             app:backgroundTint="#F2A999"
             app:iconTint="#000000"
             android:textColor="#000000"
             app:icon="@android:drawable/ic_menu_save"
             android:layout_marginTop="10dp"
             app:cornerRadius="16dp"
             android:id="@+id/btnSavePdf"
             android:text="Apply Rotation &amp; Save" />

    </LinearLayout>

    <RelativeLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:background="#CC121212"
         android:clickable="true"
         android:focusable="true"
         android:id="@+id/loadingOverlay">

        <ProgressBar
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_centerInParent="true"
             android:indeterminateTint="#F2A999" />

    </RelativeLayout>

</RelativeLayout>
