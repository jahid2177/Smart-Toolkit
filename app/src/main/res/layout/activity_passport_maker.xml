<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#121212">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="#1E1E1E"
         android:gravity="center_vertical"
         android:padding="16dp"
         android:orientation="horizontal"
         android:id="@+id/topBar">

        <ImageView
             android:layout_height="24dp"
             android:layout_width="24dp"
             android:src="@android:drawable/ic_menu_revert"
             android:background="?attr/selectableItemBackgroundBorderless"
             app:tint="@color/white"
             android:id="@+id/btnBack" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="18sp"
             android:textColor="@color/white"
             android:layout_marginStart="16dp"
             android:text="AI Passport Studio"
             android:textStyle="bold" />

        <View
             android:layout_height="0dp"
             android:layout_width="0dp"
             android:layout_weight="1" />

        <ImageView
             android:layout_height="28dp"
             android:layout_width="28dp"
             android:src="@android:drawable/ic_menu_save"
             android:background="?attr/selectableItemBackgroundBorderless"
             app:tint="#FF9800"
             android:id="@+id/btnSave" />

    </LinearLayout>

    <RelativeLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:layout_below="@id/topBar"
         android:layout_above="@+id/bottomMenu"
         android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             app:strokeColor="#2D2D2D"
             app:strokeWidth="1dp"
             app:cardBackgroundColor="#1E1E1E"
             app:cardCornerRadius="16dp">

            <RelativeLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent">

                <ImageView
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:scaleType="fitCenter"
                     android:src="@android:drawable/ic_menu_gallery"
                     android:padding="10dp"
                     app:tint="#444444"
                     android:id="@+id/ivPreview" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_centerInParent="true"
                     android:textSize="14sp"
                     android:textColor="#888888"
                     android:id="@+id/tvInstruction"
                     android:text="Upload a clear portrait photo" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:weightSum="4"
         android:background="#1E1E1E"
         android:orientation="horizontal"
         android:paddingBottom="12dp"
         android:layout_alignParentBottom="true"
         android:id="@+id/bottomMenu"
         android:paddingTop="12dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:gravity="center"
             android:orientation="vertical"
             android:layout_weight="1"
             android:id="@+id/btnUpload">

            <ImageView
                 android:layout_height="24dp"
                 android:layout_width="24dp"
                 android:src="@android:drawable/ic_menu_camera"
                 app:tint="@color/white" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="11sp"
                 android:textColor="@color/white"
                 android:layout_marginTop="4dp"
                 android:text="Upload" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:gravity="center"
             android:orientation="vertical"
             android:layout_weight="1"
             android:id="@+id/btnCropSize">

            <ImageView
                 android:layout_height="24dp"
                 android:layout_width="24dp"
                 android:src="@android:drawable/ic_menu_crop"
                 app:tint="@color/white" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="11sp"
                 android:textColor="@color/white"
                 android:layout_marginTop="4dp"
                 android:text="Size/AI" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:gravity="center"
             android:orientation="vertical"
             android:layout_weight="1"
             android:id="@+id/btnBackground">

            <ImageView
                 android:layout_height="24dp"
                 android:layout_width="24dp"
                 android:src="@android:drawable/ic_menu_mapmode"
                 app:tint="@color/white" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="11sp"
                 android:textColor="@color/white"
                 android:layout_marginTop="4dp"
                 android:text="BG Color" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:gravity="center"
             android:orientation="vertical"
             android:layout_weight="1"
             android:id="@+id/btnEnhance">

            <ImageView
                 android:layout_height="24dp"
                 android:layout_width="24dp"
                 android:src="@android:drawable/ic_menu_manage"
                 app:tint="#00BFA5" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="11sp"
                 android:textColor="#00BFA5"
                 android:layout_marginTop="4dp"
                 android:text="AI Enhance" />

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:background="#CC121212"
         android:clickable="true"
         android:focusable="true"
         android:id="@+id/loadingOverlay">

        <ProgressBar
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_centerInParent="true"
             android:indeterminateTint="#FF9800" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_centerInParent="true"
             android:textColor="@color/white"
             android:layout_marginTop="60dp"
             android:id="@+id/tvLoadingProgress"
             android:text="AI is processing..."
             android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>